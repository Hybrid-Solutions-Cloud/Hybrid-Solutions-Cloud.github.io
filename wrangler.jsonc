{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hybrid-solutions-cloud-labs",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "labs.hybridsolutions.cloud",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
